#!/usr/bin/env bash
# Approximate Omarchy directional resizing with fallback to opposite edge.
set -euo pipefail
amount="${2:?size required}"
[[ "$amount" =~ ^[0-9]+$ ]] || exit 2
case "${1:-}" in
 left) bspc node -z left "-$amount" 0 || bspc node -z right "$amount" 0;;
 right) bspc node -z left "$amount" 0 || bspc node -z right "-$amount" 0;;
 up) bspc node -z top 0 "$amount" || bspc node -z bottom 0 "-$amount";;
 down) bspc node -z bottom 0 "$amount" || bspc node -z top 0 "-$amount";;
 *) exit 2;;
esac
