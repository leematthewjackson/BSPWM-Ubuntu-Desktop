#!/usr/bin/env bash
# Read-only checks; no repair or secret retrieval.
for cmd in alacritty bspc sxhkd polybar rofi picom nmcli wpctl flatpak secret-tool lpstat flameshot copyq vlc azote feh; do
 command -v "$cmd" >/dev/null && echo "OK command $cmd" || echo "MISSING $cmd"
done
for unit in lightdm NetworkManager cups bluetooth; do systemctl is-active "$unit" | xargs echo "$unit:"; done
for proc in sxhkd polybar picom light-locker gnome-keyring-daemon copyq nextcloud; do
 pgrep -u "$UID" -f "$proc" >/dev/null && echo "RUNNING $proc" || echo "CHECK $proc"
done
busctl --user list | grep -E 'org.freedesktop.secrets|org.freedesktop.portal.Desktop' || true
nmcli device status
wpctl status
lpstat -e
echo "Manual tests required: authentication, keyring unlock, screen lock, screen sharing, sleep, printing and monitors."


for app in org.mozilla.firefox org.kde.gwenview com.nextcloud.desktopclient.nextcloud com.tomjwatson.Emote; do
 if flatpak info --system "$app" >/dev/null 2>&1; then echo "OK Flatpak $app"; else echo "MISSING Flatpak $app"; fi
done
for type in inode/directory text/plain text/html application/pdf image/png video/mp4 application/zip; do
 echo "Default $type: $(xdg-mime query default "$type")"
done
echo "Manual app tests: Super+E emoji paste, Print screenshot, Super+Ctrl+V clipboard, Nextcloud tray, browser/editor launch, file associations."
echo "Review CopyQ privacy settings; this check does not read clipboard contents."

agent=/usr/libexec/polkit-mate-authentication-agent-1
if [[ -n "$agent" && -x "$agent" ]]; then echo "OK Polkit executable: $agent"; else echo "MISSING Polkit executable"; fi
for proc in nm-applet blueman-applet light-locker xfce4-power-manager picom; do
 echo "$proc process count: $(pgrep -u "$UID" -x "$proc" | wc -l)"
done
echo "Session desktop: ${XDG_CURRENT_DESKTOP:-unset}"
echo "Default browser: $(xdg-settings get default-web-browser 2>/dev/null)"
bspc query -M --names
bspc query -D --names
echo "Portal preferences:"; cat "$HOME/.config/xdg-desktop-portal/bspwm-portals.conf" 2>/dev/null
echo "Critical manual check: suspend and close lid, resume must require password."

# Optional apps are informational, not requirements for a healthy desktop.
for cmd in brave-browser subl claude; do
 if command -v "$cmd" >/dev/null; then echo "OPTIONAL installed: $cmd"; else echo "OPTIONAL not installed: $cmd"; fi
done
