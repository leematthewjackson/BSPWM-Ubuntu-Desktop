super + space
    rofi -show drun
super + Return
    kitty
super + e
    thunar
super + b
    xdg-open https://www.google.com
super + w
    bspc node -c
super + {Left,Down,Up,Right}
    bspc node -f {west,south,north,east}
super + shift + {Left,Down,Up,Right}
    bspc node -s {west,south,north,east}
super + {1-9}
    bspc desktop -f '^{1-9}'
super + shift + {1-9}
    bspc node -d '^{1-9}' --follow
super + f
    bspc node -t '~fullscreen'
super + t
    bspc node -t '~floating'
super + m
    bspc desktop -l next
super + l
    light-locker-command -l
super + Escape
    ~/.local/bin/desktop-power
super + v
    copyq toggle
Print
    flameshot gui
XF86AudioRaiseVolume
    wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
XF86AudioLowerVolume
    wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
XF86AudioMute
    wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
XF86AudioMicMute
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
XF86MonBrightnessUp
    brightnessctl set +5%
XF86MonBrightnessDown
    brightnessctl set 5%-
super + alt + r
    bspc wm -r
super + alt + k
    kitty micro ~/.config/sxhkd/sxhkdrc
super + alt + b
    kitty micro ~/.config/bspwm/bspwmrc
super + alt + p
    kitty micro ~/.config/polybar/config.ini

